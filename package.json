{
	"name": "8around-sns",
	"version": "0.1.0",
	"private": true,
	"scripts": {
		"dev": "next dev",
		"build": "next build",
		"start": "next start",
		"lint": "biome check",
		"format": "biome check --write",
		"typecheck": "next typegen && tsc --noEmit",
		"test": "vitest run --passWithNoTests",
		"verify": "npm run lint && npm run typecheck && npm run test && npm run harness",
		"db:push": "supabase db push",
		"db:diff": "supabase db diff",
		"types:gen": "mkdir -p types && supabase gen types typescript --linked > types/database.ts && biome format --write types/database.ts",
		"db:link": "supabase link",
		"harness": "node scripts/harness-check.mjs"
	},
	"dependencies": {
		"@radix-ui/react-dialog": "^1.1.23",
		"@radix-ui/react-dropdown-menu": "^2.1.24",
		"@supabase/ssr": "^0.12.7",
		"@supabase/supabase-js": "^2.116.0",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"lucide-react": "^1.45.0",
		"next": "16.3.4",
		"react": "19.2.8",
		"react-dom": "19.2.8",
		"tailwind-merge": "^3.6.0",
		"zod": "^4.6.2"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.13",
		"@tailwindcss/postcss": "^4",
		"@types/node": "^20",
		"@types/react": "^19",
		"@types/react-dom": "^19",
		"supabase": "^2.117.0",
		"tailwindcss": "^4",
		"typescript": "^5",
		"vitest": "^4.1.11"
	}
}
